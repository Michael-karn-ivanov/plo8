# trainer: the neural networks, the acting policy and the rollout loop (and, in
# later stages, the training loop) for a fixed-limit Omaha Hi-Lo 8-or-better bot,
# on top of //rl_env and //arena.
#
# torch and numpy are not buck2 targets: the repo's Python toolchain
# (toolchains/BUCK) runs the repo venv interpreter (.venv, requirements-rl.txt), so
# `import torch` works here as `import numpy` does in rl_env.

python_library(
    name = "trainer",
    srcs = glob(["trainer/**/*.py"]),
    # Module paths are taken relative to this directory, so the sources under
    # trainer/ import as `trainer.*`.
    base_module = "",
    # //arena:arena: the baseline bots of the rollout loop (the evaluator later).
    deps = [
        "//arena:arena",
        "//rl_env:rl_env",
    ],
    visibility = ["PUBLIC"],
)

# Fast tests (CPU, seconds; the table runs use small networks and few tables).
python_test(
    name = "trainer_test",
    srcs = glob(["tests/*.py"]),
    base_module = "trainer_tests",
    deps = [
        ":trainer",
        "//arena:arena",
        "//rl_env:rl_env",
    ],
)
