# trainer: the neural networks, the acting policy, the rollout loop and the PPO
# learner (and, in later stages, the driver and league) for a fixed-limit Omaha
# Hi-Lo 8-or-better bot, on top of //rl_env and //arena.
#
# torch and numpy are not buck2 targets: the repo's Python toolchain
# (toolchains/BUCK) runs the repo venv interpreter (.venv, requirements-rl.txt), so
# `import torch` works here as `import numpy` does in rl_env.

python_library(
    name = "trainer",
    srcs = glob(["trainer/**/*.py"]),
    # Module paths are taken relative to this directory, so the sources under
    # trainer/ import as `trainer.*`.
    base_module = "",
    # //arena:arena: the baseline bots of the rollout loop (the evaluator later).
    deps = [
        "//arena:arena",
        "//rl_env:rl_env",
    ],
    visibility = ["PUBLIC"],
)

# CPU tests with small networks (64 x 2) and few tables; most take seconds, the
# collect-and-update run of test_learning about 15-30 s.
python_test(
    name = "trainer_test",
    srcs = glob(["tests/*.py"]),
    base_module = "trainer_tests",
    deps = [
        ":trainer",
        "//arena:arena",
        "//rl_env:rl_env",
    ],
)
