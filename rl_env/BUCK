# rl_env: the reinforcement-learning environment for fixed-limit Omaha Hi-Lo
# 8-or-better. Drives //engine in step mode; gives tables, decisions, observation
# vectors, action masks, results and training records.
#
# numpy is not a buck2 target: the repo's Python toolchain (toolchains/BUCK) runs the
# repo venv interpreter (.venv, requirements-rl.txt), so `import numpy` works here.

python_library(
    name = "rl_env",
    srcs = glob(["rl_env/**/*.py"]),
    # Module paths are taken relative to this directory, so the sources under
    # rl_env/ import as `rl_env.*`.
    base_module = "",
    deps = [
        "//engine:engine",
        "//entities:entities",
    ],
    visibility = ["PUBLIC"],
)

# Only the tests depend on cli_server (protocol round trip and recorded hands).
python_test(
    name = "rl_env_test",
    srcs = glob(["tests/*.py"]),
    base_module = "rl_env_tests",
    deps = [
        ":rl_env",
        "//cli_server:e2e",
        "//cli_server:protocol",
    ],
)

# 100,000 random hands through a TableBatch (minutes). For quick local runs lower
# the count with the RL_ENV_FUZZ_HANDS environment variable.
python_test(
    name = "rl_env_fuzz_test",
    srcs = glob(["fuzz/*.py"]),
    base_module = "rl_env_fuzz",
    deps = [":rl_env"],
)

# Rollout benchmark: buck2 run //rl_env:bench -- [options]
python_binary(
    name = "bench",
    main = "bench/bench.py",
    # Keep the tool out of the `rl_env` package namespace.
    base_module = "rl_env_bench",
    deps = [":rl_env"],
)
