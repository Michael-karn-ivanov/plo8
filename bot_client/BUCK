# bot_client: a headless client that seats one arena bot at a running //cli_server
# table and plays it there with no human in the loop.
#
# numpy is not a buck2 target: the repo's Python toolchain (toolchains/BUCK) runs the
# repo venv interpreter (.venv). It is reached through //arena and //rl_env only;
# bot_client's own modules do not import it.

python_library(
    name = "bot_client_lib",
    srcs = glob(["bot_client/*.py"]),
    # Module paths are taken relative to this directory, so the sources under
    # bot_client/ import as `bot_client.*`.
    base_module = "",
    deps = [
        "//arena:arena",
        "//cli_client:net",  # networking only: no curses UI, no controller
        "//cli_server:protocol",
        "//engine:engine",
        "//entities:entities",
        "//rl_env:rl_env",
    ],
)

python_test(
    name = "bot_client_test",
    srcs = glob(["tests/*.py"]),
    base_module = "bot_client_tests",
    deps = [
        ":bot_client_lib",
        # The integration tests run an in-process GameServer; test_lost_server
        # starts `python -m cli_server.main` as a child process.
        "//cli_server:cli_server_lib",
    ],
)
