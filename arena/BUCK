# arena: baseline bots and the duplicate-match evaluator for fixed-limit Omaha
# Hi-Lo 8-or-better, on top of //rl_env.
#
# numpy is not a buck2 target: the repo's Python toolchain (toolchains/BUCK) runs the
# repo venv interpreter (.venv), so `import numpy` works here (as in rl_env).

python_library(
    name = "arena",
    srcs = glob(["arena/**/*.py"]),
    # Module paths are taken relative to this directory, so the sources under
    # arena/ import as `arena.*`.
    base_module = "",
    deps = [
        "//engine:engine",
        "//entities:entities",
        "//rl_env:rl_env",
    ],
    visibility = ["PUBLIC"],
)

# Fast tests (seconds).
python_test(
    name = "arena_test",
    srcs = glob(["tests/*.py"]),
    base_module = "arena_tests",
    deps = [":arena"],
)
